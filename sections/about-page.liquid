{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign business = settings.legal_name
  assign email = settings.support_email
  assign address = settings.legal_address
  assign returns_page = pages['returns']
-%}
{%- capture delivery_text -%}{%- render 'store-delivery-window' -%}{%- endcapture -%}
{%- assign delivery_text = delivery_text | strip -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="about-page rte">
      <h1 class="main-page-title page-title h0">{{ page.title | escape }}</h1>

      {%- if section.settings.intro != blank -%}
        {{ section.settings.intro }}
      {%- elsif request.design_mode -%}
        <p class="design-hint">Add a short, true introduction in this section's settings: what you sell and the problem it solves. Do not invent a founder story, a team, awards or years in business.</p>
      {%- endif -%}

      {%- if section.settings.show_us_warehouse -%}
        <h2>How it works</h2>
        <p>
          We do not keep products in our own warehouse. Orders go to U.S. suppliers, and your order ships from a U.S. warehouse with tracking.
          {%- if delivery_text != blank %} After shipping, delivery is typically {{ delivery_text }}.{% endif -%}
        </p>
      {%- endif -%}

      {%- if business != blank -%}
        <h2>Who runs this</h2>
        <p>
          {{ shop.name | escape }} is run by {{ business | escape }}.
          {%- if address != blank %}<br>{{ address | escape | newline_to_br }}{% endif -%}
          {%- if email != blank %}<br>Write to <a href="mailto:{{ email | escape }}">{{ email | escape }}</a>.{% endif -%}
        </p>
      {%- elsif request.design_mode -%}
        <p class="design-hint">Fill in Business name, address and email under Theme settings, Store facts. The "Who runs this" paragraph appears once Business name is set.</p>
      {%- endif -%}

      <h2>What we promise</h2>
      <ul>
        <li>We describe products only as the supplier's specifications describe them.</li>
        <li>
          If something arrives damaged, defective or not as described, we make it right.
          {%- if returns_page.url != blank %} See our <a href="{{ returns_page.url }}">Returns page</a>.{% endif -%}
        </li>
        <li>We never write fake reviews.</li>
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About page",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "info": "What you sell and the problem it solves. Keep it true and short."
    },
    {
      "type": "checkbox",
      "id": "show_us_warehouse",
      "label": "Show \"How it works\" (orders ship from a U.S. warehouse)",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "About page"
    }
  ]
}
{% endschema %}
