{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign hd = settings.handling_days
  assign rd = settings.return_days
  assign email = settings.support_email
  assign returns_page = pages['returns']
  assign cards = 0
-%}
{%- capture handling_text -%}{%- render 'store-days', count: hd -%}{%- endcapture -%}
{%- capture delivery_text -%}{%- render 'store-delivery-window' -%}{%- endcapture -%}
{%- capture reply_text -%}{%- render 'store-hours', count: settings.reply_hours -%}{%- endcapture -%}
{%- assign handling_text = handling_text | strip -%}
{%- assign delivery_text = delivery_text | strip -%}
{%- assign reply_text = reply_text | strip -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="facts-heading inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <ul class="facts-grid">
      {%- if handling_text != blank or settings.free_us_shipping -%}
        {%- assign cards = cards | plus: 1 -%}
        <li class="facts-card">
          <h3 class="h4">Shipping</h3>
          <p>
            {%- if section.settings.show_us_warehouse -%}Ships from a U.S. warehouse
              {%- if handling_text != blank %} within {{ handling_text }} of payment{% endif -%}.
            {%- elsif handling_text != blank -%}Ships within {{ handling_text }} of payment.
            {%- endif -%}
            {%- if settings.free_us_shipping %} Free shipping to U.S. addresses.{% endif -%}
          </p>
        </li>
      {%- endif -%}

      {%- if delivery_text != blank -%}
        {%- assign cards = cards | plus: 1 -%}
        <li class="facts-card">
          <h3 class="h4">Delivery</h3>
          <p>After shipping, delivery is typically {{ delivery_text }}. You get a tracking link by email.</p>
        </li>
      {%- endif -%}

      {%- if rd > 0 -%}
        {%- assign cards = cards | plus: 1 -%}
        <li class="facts-card">
          <h3 class="h4">Returns</h3>
          <p>
            Return an item within {{ rd }} days of delivery.
            {%- if returns_page.url != blank %} <a href="{{ returns_page.url }}">Read the returns policy</a>.{% endif -%}
          </p>
        </li>
      {%- endif -%}

      {%- if email != blank -%}
        {%- assign cards = cards | plus: 1 -%}
        <li class="facts-card">
          <h3 class="h4">Questions</h3>
          <p>
            Write to <a href="mailto:{{ email | escape }}">{{ email | escape }}</a>.
            {%- if reply_text != blank %} We reply within {{ reply_text }}.{% endif -%}
          </p>
        </li>
      {%- endif -%}
    </ul>

    {%- if cards == 0 and request.design_mode -%}
      <p class="design-hint">Open Theme settings, then Store facts, and fill in your shipping, delivery, return and support details. This section shows only what you fill in.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Shipping and returns",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Reads Theme settings, Store facts. Empty fields are hidden, so nothing untrue is shown."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shipping and returns"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h1", "label": "Large" },
        { "value": "h2", "label": "Medium" },
        { "value": "h3", "label": "Small" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "checkbox",
      "id": "show_us_warehouse",
      "label": "Say orders ship from a U.S. warehouse",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Shipping and returns"
    }
  ]
}
{% endschema %}
