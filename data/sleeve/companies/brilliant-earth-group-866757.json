28026044956/0001628280-26-044956-index.htm"},{"text":"Base rate: 57.8% of US common stocks underperformed one-month Treasury bills over their lifetimes (Bessembinder, Journal of Financial Economics, 2018). Nothing above changes that starting point.","source_url":"https://doi.org/10.1016/j.jfineco.2018.06.004"}],"triggers":[{"id":"gross_margin_floor","kind":"metric","label":"Gross margin falls below 46.0% for 2 consecutive quarters","metric":"gross_margin","comparison":"below","threshold":0.46,"consecutive":2,"current":0.543,"current_display":"54.3%","threshold_display":"46.0%","fired":false,"rationale":"Eight points of margin is a real deterioration rather than noise. Two consecutive quarters stops one bad quarter from forcing a sale.","editable":true},{"id":"growth_floor","kind":"metric","label":"Revenue growth falls below -9.0% for 2 consecutive quarters","metric":"revenue_growth_yoy","comparison":"below","threshold":-0.09,"consecutive":2,"current":0.06,"current_display":"6.0%","threshold_display":"-9.0%","fired":false,"rationale":"If growth halves and stays there, the reason you looked at this company has gone.","editable":true},{"id":"runway_floor","kind":"metric","label":"Cash runway falls below 12 months","metric":"runway_months","comparison":"below","threshold":12.0,"consecutive":1,"current":20.859,"current_display":"21 months","threshold_display":"12 months","fired":false,"rationale":"Below twelve months the company raises on whatever terms it can get, and that dilution lands on you.","editable":true},{"id":"dilution_ceiling","kind":"metric","label":"Diluted share count growth rises above 19.0%","metric":"dilution_yoy","comparison":"above","threshold":0.19,"consecutive":1,"current":0.12,"current_display":"12.0%","threshold_display":"19.0%","fired":false,"rationale":"Share count growth above this rate transfers your stake to new holders faster than the business is likely to compound.","editable":true},{"id":"leverage_ceiling","kind":"metric","label":"Debt to 