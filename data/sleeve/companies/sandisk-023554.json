{"schema_version":"1.0.0","id":"cik-0002023554","cik":"0002023554","slug":"sandisk-023554","name":"Sandisk Corp","ticker":"SNDK","exchanges":["Nasdaq"],"sector":"Computer Storage Devices","sic":"3572","country":"CA","website":"","listed_years":0.9,"first_annual":"2025-08-21","last_filing":"2026-07-02","annual_only":false,"edgar_url":"https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=0002023554&type=10-K","narrative":{"source_url":"https://www.sec.gov/Archives/edgar/data/2023554/000202355425000034/0002023554-25-000034-index.htm","source_form":"10-K","source_date":"2025-08-21","business":"Separation from Western Digital Corporation Prior to February 21, 2025, we were wholly owned by Western Digital Corporation (\"WDC\"). As of February 21, 2025, we separated from WDC (the \"separation\") and became a standalone publicly traded company, trading under the stock symbol \"SNDK\" on the Nasdaq Global Select Market. For more information about the separation, see Part II, Item 7., Management's Discussion and Analysis of Financial Condition and Results of Operation and Part II, Item 8., Note 1, Organization, Basis of Presentation and Summary of Significant Accounting Policies of the Notes to the Consolidated Financial Statements included in this Annual Report on Form 10-K. General Sandisk is a leading developer, manufacturer and provider of data storage devices and solutions based on NAND flash technology. With a differentiated innovation engine driving advancements in storage and semiconductor technologies, our broad and ever-expanding portfolio delivers powerful flash storage solutions for AI workloads in datacenters, edge devices, and consumers. Our technologies enable everyone from students, gamers, and home offices to the largest enterprises and public clouds to produce, analyze, and store data. Our solutions include a broad range of solid-state drives, embedded products, removable cards, universal serial bus drives and wafers and components. Our broad portfolio of technology and products addresses multiple end markets of \"Cloud,\" \"Client\" and \"Consumer.\" Through the Client end market, we provide our original equipment manufacturer and channel customers a broad array of high-performance flash solutions across personal computer, mobile, gaming, automotive, virtual reality headsets, at-home entertainment, and industrial spaces. \u2026"},"story":[{"date":"2025-02-21","form":"S-8","label":"Employee share plan registered","kind":"people","url":"https://www.sec.gov/Archives/edgar/data/2023554/000119312525031971/0001193125-25-031971-index.htm"},{"date":"2025-04-18","form":"S-1","label":"Registration statement filed \u2014 the IPO prospectus","kind":"listing","url":"https://www.sec.gov/Archives/edgar/data/2023554/000119312525085694/0001193125-25-085694-index.htm"},{"date":"2025-05-02","form":"S-1/A","label":"Registration statement amended","kind":"listing","url":"https://www.sec.gov/Archives/edgar/data/2023554/000119312525110314/0001193125-25-110314-index.htm"},{"date":"2025-05-30","form":"S-1/A","label":"Registration statement amended","kind":"listing","url":"https://www.sec.gov/Archives/edgar/data/2023554/000119312525132306/0001193125-25-132306-index.htm"},{"date":"2025-06-04","form":"S-1/A","label":"Registration statement amended","kind":"listing","url":"https://www.sec.gov/Archives/edgar/data/2023554/000119312525134938/0001193125-25-134938-index.htm"},{"date":"2025-06-06","form":"424B4","label":"IPO priced and offered","kind":"listing","url":"https://www.sec.gov/Archives/edgar/data/2023554/000119312525137164/0001193125-25-137164-index.htm"},{"date":"2025-10-07","form":"DEF 14A","label":"Proxy statement \u2014 pay, board, votes","kind":"governance","url":"https://www.sec.gov/Archives/edgar/data/2023554/000162828025044481/0001628280-25-044481-index.htm"}],"quarterly":[{"period":"Q1 2026","revenue":5950000000.0,"growth":2.51,"gross_margin":0.784,"operating_income":4111000000.0,"operating_cash_flow":null,"cash":373500000