d":"news","tone":"blue"}],"url":"https://www.sec.gov/Archives/edgar/data/1800667/000119312526073842/0001193125-26-073842-index.htm"},{"date":"2026-02-12","form":"8-K","codes":["2.02","9.01"],"events":[{"label":"Results announced","kind":"results","tone":"blue"}],"url":"https://www.sec.gov/Archives/edgar/data/1800667/000119312526048726/0001193125-26-048726-index.htm"},{"date":"2025-11-06","form":"8-K","codes":["2.02","9.01"],"events":[{"label":"Results announced","kind":"results","tone":"blue"}],"url":"https://www.sec.gov/Archives/edgar/data/1800667/000119312525269563/0001193125-25-269563-index.htm"},{"date":"2025-09-25","form":"8-K","codes":["5.02","9.01"],"events":[{"label":"Director or officer departure or appointment","kind":"people","tone":"warn"}],"url":"https://www.sec.gov/Archives/edgar/data/1800667/000119312525217487/0001193125-25-217487-index.htm"},{"date":"2025-08-07","form":"8-K","codes":["2.02","9.01"],"events":[{"label":"Results announced","kind":"results","tone":"blue"}],"url":"https://www.sec.gov/Archives/edgar/data/1800667/000095017025105041/0000950170-25-105041-index.htm"},{"date":"2025-05-22","form":"8-K","codes":["5.07"],"events":[{"label":"Shareholder vote results","kind":"governance","tone":"blue"}],"url":"https://www.sec.gov/Archives/edgar/data/1800667/000095017025076333/0000950170-25-076333-index.htm"},{"date":"2025-05-08","form":"8-K","codes":["2.02","9.01"],"events":[{"label":"Results announced","kind":"results","tone":"blue"}],"url":"https://www.sec.gov/Archives/edgar/data/1800667/000095017025066960/0000950170-25-066960-index.htm"},{"date":"2025-03-26","form":"8-K","codes":["5.02"],"events":[{"label":"Director or officer departure or appointment","kind":"people","tone":"warn"}],"url":"https://www.sec.gov/Archives/edgar/data/1800667/000095017025045221/0000950170-25-045221-index.htm"}],"legal_events":[],"summary":{"sentences":["JFrog Ltd files with the SEC under \"Services-Prepackaged Software\", based in CA, and has been publicly reporting for 5 years.","It reported $540.5m of revenue over the trailing four quarters, up 25.8% against the same quarter a year earlier, at a gross margin of 78.2%.","Listed on Nasdaq, it funds itself from operations ($83.5m of operating cash flow over the year)."],"generated":true,"note":"Assembled from filing metadata and XBRL figures. Not editorial judgement - and rule 7 asks whether *you* can explain it, so rewrite this in your own words before you rely on it."},"bull":[{"text":"Revenue grew 25.8% year on year (Q1 2026 vs Q1 2025), reaching $154.0m in the quarter.","source_url":"https://www.sec.gov/Archives/edgar/data/1800667/000119312526214647/0001193125-26-214647-index.htm","accession":"0001193125-26-214647"},{"text":"Growth has been positive in all 8 year-on-year comparisons, so this is a trend rather than one good quarter.","source_url":"https://www.sec.gov/Archives/edgar/data/1800667/000119312526214647/0001193125-26-214647-index.htm","accession":"0001193125-26-214647"},{"text":"Gross margin of 78.2% means most of each additional sale falls through to cover fixed costs.","source_url":"https://www.sec.gov/Archives/edgar/data/1800667/000119312526214647/0001193125-26-214647-index.htm","accession":"0001193125-26-214647"},{"text":"Gross margin expanded from 75.3% to 78.2% against the same quarter a year earlier - the company is keeping more of what it sells, not buying growth with discounts.","source_url":"https://www.sec.gov/Archives/edgar/data/1800667/000119312526214647/0001193125-26-214647-index.htm","accession":"0001193125-26-214647"},{"text":"Operating cash flow is positive at $83.5m over the trailing year, so the business funds itself and is not dependent on raising money.","source_url":"https://www.sec.gov/Archives/edgar/data/1800667/000119312526214647/0001193125-26-214647-index.htm","accession":"0001193125-26-214647"},{"text":"Net cash of $741.2m against total assets of $1.4bn - no debt overhang forcing decisions.","source_url":"https://www.sec.gov/Archives/edgar/data/1800667/000119312526214647/0001193125-26-214647-index.htm","accession":"0001193125-26-214647"}],"bear":[{"text":"The company is loss-making at the operating line (-8.4% margin). Profitability is a forecast, not a fact.","source_url":"https://www.sec.gov/Archives/edgar/data/1800667/000119312526214647/0001193125-26-214647-index.htm","accession":"0001193125-26-214647"},{"text":"Diluted share count rose 5.9% over the year (Q1 2026 vs Q1 2025). The company can grow while your share of it shrinks, and this is the number most commentary ignores.","source_url":"https://www.sec.gov/Archives/edgar/data/1800667/000119312526214647/0001193125-26-214647-index.htm","accession":"0001193125-26-214647"},{"text":"Insiders disposed of 3.9% of their combined holdings over the last four quarters (584,847 shares across 14 ownership filings). People with the best view of the business were reducing their stake.","source_url":"https://www.sec.gov/Archives/edgar/data/1800667/000122734826000008/0001227348-26-000008-index.htm"},{"text":"Base rate: 57.8% of US common stocks underperformed one-month Treasury bills over their lifetimes (Bessembinder, Journal of Financial Economics, 2018). Nothing above changes that starting point.","source_url":"https://doi.org/10.1016/j.jfineco.2018.06.004"}],"triggers":[{"id":"gross_margin_floor","kind":"metric","label":"Gross margin falls below 70.0% for 2 consecutive quarters","metric":"gross_margin","comparison":"below","threshold":0.7,"consecutive":2,"current":0.782,"current_display":"78.2%","threshold_display":"70.0%","fired":false,"rationale":"Eight points of margin is a real deterioration rather than noise. Two consecutive quarters stops one bad quarter from forcing a sale.","editable":true},{"id":"growth_floor","kind":"metric","label":"Revenue growth falls below 11.0% for 2 consecutive quarters","metric":"revenue_growth_yoy","comparison":"below","threshold":0.11,"consecutive":2,"current":0.258,"current_display":"25.8%","threshold_display":"11.0%","f