{"schema_version":"1.0.0","id":"cik-0001788882","cik":"0001788882","slug":"root-788882","name":"Root, Inc.","ticker":"ROOT","exchanges":["Nasdaq"],"sector":"Fire, Marine & Casualty Insurance","sic":"6331","country":"OH","website":"","listed_years":5.4,"first_annual":"2021-03-04","last_filing":"2026-07-29","annual_only":false,"edgar_url":"https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=0001788882&type=10-K","narrative":{"source_url":"https://www.sec.gov/Archives/edgar/data/1788882/000178888226000014/0001788882-26-000014-index.htm","source_form":"10-K","source_date":"2026-02-25","business":"Overview Root is a technology insurance company founded on the idea that car insurance rates should be based primarily on driving behaviors, not demographics. We are revolutionizing the archaic car insurance industry by using modern technology, data science, and telematics to offer fair, personalized rates to good drivers. We primarily reach customers through two channels: our direct channel, where we target consumers with what we believe to be a great insurance product at a great price, and through our partnership channel, where we meet consumers at contextually relevant times, such as during the car purchasing experience or through independent insurance agents. Our primary focus is the United States personal auto insurance market. We have built our company around the principle that each individual has unique behaviors and that customers should be in control and rewarded for their actio \u2026","legal":"From time to time, we are party to litigation and legal proceedings relating to our business operations. While the outcome of all legal actions is not presently determinable, except as noted in Note 13, \"Commitments and Contingencies,\" in the Notes to Consolidated Financial Statements, we do not believe that we are party to any current or pending legal action that, if concluded adversely, could reasonably be expected to have a material adverse effect on our financial condition or results of operations and cash flows. 62","legal_material":true},"story":[{"date":"2024-02-13","form":"SC 13G","label":"Passive 5%+ stake disclosed","kind":"governance","url":"https://www.sec.gov/Archives/edgar/data/1788882/000194104024000139/0001941040-24-000139-index.htm"},{"date":"2024-02-14","form":"SC 13G","label":"Passive 5%+ stake disclosed","kind":"governance","url":"https://www.sec.gov/Archives/edgar/data/1788882/000119312524034974/0001193125-24-034974-index.htm"},{"date":"2024-04-26","form":"DEF 14A","label":"Proxy statement \u2014 pay, board, votes","kind":"governance","url":"https://www.sec.gov/Archives/edgar/data/1788882/000162828024018439/0001628280-24-018439-index.htm"},{"date":"2024-05-29","form":"S-8","label":"Employee share plan registered","kind":"people","url":"https://www.sec.gov/Archives/edgar/data/1788882/000162828024025601/0001628280-24-025601-index.htm"},{"date":"2024-10-24","form":"SC 13G","label":"Passive 5%+ stake disclosed","kind":"governance","url":"https://www.sec.gov/Archives/edgar/data/1788882/000201238324002145/0002012383-24-002145-index.htm"},{"date":"2024-11-08","form":"SC 13G","label":"Passive 5%+ stake disclosed","kind":"governance","url":"https://www.sec.gov/Archives/edgar/data/1788882/000201238324003676/0002012383-24-003676-index.htm"},{"date":"2025-04-25","form":"DEF 14A","label":"Proxy statement \u2014 pay, board, votes","kind":"governance","url":"https://www.sec.gov/Archives/edgar/data/1788882/000162828025019802/0001628280-25-019802-index.htm"},{"date":"2025-06-05","form":"S-8","label":"Employee share plan registered","kind":"people","url":"https://www.sec.gov/Archives/edgar/data/1788882/000178888225000007/0001788882-25-000007-index.htm"},{"date":"2026-04-24","form":"DEF 14A","label":"Proxy statement \u2014 pay, board, votes","kind":"governance","url":"https://www.sec.gov/Archives/edgar/data/1788882/000178888226000033/0001788882-26-000033-index.htm"},{"date":"2026-06-08","form":"S-8","label":"Employee share 