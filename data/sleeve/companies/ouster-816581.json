{"schema_version":"1.0.0","id":"cik-0001816581","cik":"0001816581","slug":"ouster-816581","name":"Ouster, Inc.","ticker":"OUST","exchanges":["Nasdaq"],"sector":"General Industrial Machinery & Equipment, NEC","sic":"3569","country":"CA","website":"","listed_years":5.4,"first_annual":"2021-03-09","last_filing":"2026-07-29","annual_only":false,"edgar_url":"https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=0001816581&type=10-K","narrative":{"source_url":"https://www.sec.gov/Archives/edgar/data/1816581/000162828026013313/0001628280-26-013313-index.htm","source_form":"10-K","source_date":"2026-03-02","business":"Overview Ouster, Inc. is a leader in sensing and perception for Physical Artificial Intelligence (Physical AI). Ouster enables machines to \"Sense, Think, Act, and Learn\" and independently execute tasks without human intervention. Physical AI allows machines to move beyond fixed, preprogrammed behavior into adaptive, intelligent action by focusing on perception, understanding, and learning from the physical world. As a pioneer in Physical AI, Ouster offers a unified sensing and perception platform that combines high-performance digital lidar, cameras, AI compute, sensor fusion and perception software, and cutting-edge AI models to our customers. We anticipate that 3D vision technologies, coupled with artificial intelligence, will power autonomy that in turn will fundamentally disrupt business models across many existing industries and enable entirely new industries and capabilities. We be \u2026"},"story":[{"date":"2025-05-02","form":"S-3","label":"Shelf registration filed \u2014 capacity to raise later","kind":"finance","url":"https://www.sec.gov/Archives/edgar/data/1816581/000119312525111604/0001193125-25-111604-index.htm"},{"date":"2025-05-12","form":"424B5","label":"Follow-on offering","kind":"finance","url":"https://www.sec.gov/Archives/edgar/data/1816581/000119312525117774/0001193125-25-117774-index.htm"},{"date":"2025-09-30","form":"25-NSE","l